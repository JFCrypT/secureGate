[Unit]
Description=secureGate backend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=USUARIO_RPI
Group=USUARIO_RPI
WorkingDirectory=/home/USUARIO_RPI/secureGate
EnvironmentFile=/etc/securegate/securegate.env
ExecStart=/home/USUARIO_RPI/secureGate/.venv/bin/python raspberry/backend_api.py --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
