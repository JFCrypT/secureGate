# Copiar a frontend/.env (desarrollo) o a /etc/securegate/frontend.env (Pi).
# Nunca commitear el archivo real ni poner valores verdaderos acá.

# Desarrollo: API falsa (python dev/mock_api.py). En la Pi: http://127.0.0.1:8000
SECUREGATE_API_URL=http://127.0.0.1:8100

# El mismo token que usa la API. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECUREGATE_API_TOKEN=REEMPLAZAR_POR_TOKEN_DE_32_CARACTERES_O_MAS

# Firma de la cookie de sesión (otro valor aleatorio, distinto del token).
FRONT_SESSION_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_32_O_MAS

# Operadores con hash bcrypt; se administra con cli.py. En la Pi:
# /etc/securegate/frontend-operators.json (permisos 600).
FRONT_OPERATORS_FILE=operators.json

FRONT_BASE_PATH=/dashboard
FRONT_TIMEZONE=America/Argentina/Buenos_Aires
FRONT_POLL_REALTIME_MS=2000
FRONT_POLL_STATUS_MS=5000
FRONT_SESSION_HOURS=8
